{
    "version": "1.0.0",
    "tables": [
        {
            "name": "optilarity_domains",
            "columns": [
                {
                    "name": "id",
                    "type": "primary"
                },
                {
                    "name": "customer_id",
                    "type": "integer"
                },
                {
                    "name": "domain_name",
                    "type": "string",
                    "size": 255
                },
                {
                    "name": "registrar",
                    "type": "string",
                    "size": 100,
                    "default": "Internal"
                },
                {
                    "name": "status",
                    "type": "string",
                    "size": 20,
                    "default": "active"
                },
                {
                    "name": "privacy_protection",
                    "type": "boolean",
                    "default": false
                },
                {
                    "name": "auto_renew",
                    "type": "boolean",
                    "default": true
                },
                {
                    "name": "expiry_date",
                    "type": "datetime"
                },
                {
                    "name": "created_at",
                    "type": "datetime"
                },
                {
                    "name": "updated_at",
                    "type": "datetime"
                }
            ],
            "indexes": [
                {
                    "columns": [
                        "domain_name"
                    ],
                    "unique": true
                },
                {
                    "columns": [
                        "customer_id"
                    ]
                }
            ],
            "foreign_keys": [
                {
                    "column": "customer_id",
                    "references": "optilarity_customers",
                    "on": "id",
                    "on_delete": "CASCADE"
                }
            ]
        },
        {
            "name": "optilarity_domain_orders",
            "columns": [
                {
                    "name": "id",
                    "type": "primary"
                },
                {
                    "name": "domain_id",
                    "type": "integer"
                },
                {
                    "name": "order_id",
                    "type": "integer"
                },
                {
                    "name": "meta_data",
                    "type": "json",
                    "nullable": true
                },
                {
                    "name": "created_at",
                    "type": "datetime"
                }
            ],
            "indexes": [
                {
                    "columns": [
                        "domain_id",
                        "order_id"
                    ],
                    "unique": true
                }
            ],
            "foreign_keys": [
                {
                    "column": "domain_id",
                    "references": "optilarity_domains",
                    "on": "id",
                    "on_delete": "CASCADE"
                },
                {
                    "column": "order_id",
                    "references": "optilarity_orders",
                    "on": "id",
                    "on_delete": "CASCADE"
                }
            ]
        }
    ]
}