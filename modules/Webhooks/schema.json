{
    "version": "1.0.0",
    "module": "webhooks",
    "description": "Webhooks. No FKs — webhooks fire for any module event.",
    "tables": [
        {
            "name": "optilarity_webhooks",
            "comment": "Registered webhook endpoints (send events to external URLs).",
            "columns": [
                {
                    "name": "id",
                    "type": "primary"
                },
                {
                    "name": "name",
                    "type": "string",
                    "size": 200,
                    "nullable": false
                },
                {
                    "name": "url",
                    "type": "string",
                    "size": 2000,
                    "nullable": false
                },
                {
                    "name": "secret",
                    "type": "string",
                    "size": 255,
                    "nullable": true,
                    "comment": "HMAC secret for signature verification"
                },
                {
                    "name": "events",
                    "type": "json",
                    "nullable": false,
                    "comment": "Array of event names, e.g. ['order.created','license.activated']"
                },
                {
                    "name": "is_active",
                    "type": "boolean",
                    "default": true
                },
                {
                    "name": "created_at",
                    "type": "datetime",
                    "nullable": false
                },
                {
                    "name": "updated_at",
                    "type": "datetime",
                    "nullable": true
                }
            ],
            "indexes": [
                {
                    "name": "idx_webhook_active",
                    "columns": [
                        "is_active"
                    ]
                }
            ]
        },
        {
            "name": "optilarity_webhook_deliveries",
            "comment": "Delivery log for each webhook dispatch attempt.",
            "columns": [
                {
                    "name": "id",
                    "type": "primary"
                },
                {
                    "name": "webhook_id",
                    "type": "integer",
                    "nullable": false,
                    "comment": "FK -> optilarity_webhooks.id"
                },
                {
                    "name": "event",
                    "type": "string",
                    "size": 200,
                    "nullable": false
                },
                {
                    "name": "payload",
                    "type": "json",
                    "nullable": true
                },
                {
                    "name": "response_code",
                    "type": "integer",
                    "nullable": true
                },
                {
                    "name": "response_body",
                    "type": "text",
                    "nullable": true
                },
                {
                    "name": "status",
                    "type": "enum",
                    "values": [
                        "pending",
                        "delivered",
                        "failed"
                    ],
                    "default": "pending",
                    "nullable": false
                },
                {
                    "name": "attempts",
                    "type": "integer",
                    "default": 0
                },
                {
                    "name": "created_at",
                    "type": "datetime",
                    "nullable": false
                },
                {
                    "name": "delivered_at",
                    "type": "datetime",
                    "nullable": true
                }
            ],
            "indexes": [
                {
                    "name": "idx_delivery_webhook",
                    "columns": [
                        "webhook_id"
                    ]
                },
                {
                    "name": "idx_delivery_event",
                    "columns": [
                        "event"
                    ]
                },
                {
                    "name": "idx_delivery_status",
                    "columns": [
                        "status"
                    ]
                },
                {
                    "name": "idx_delivery_created",
                    "columns": [
                        "created_at"
                    ]
                }
            ],
            "foreign_keys": [
                {
                    "column": "webhook_id",
                    "references": "optilarity_webhooks",
                    "on": "id",
                    "on_delete": "CASCADE",
                    "on_update": "CASCADE"
                }
            ]
        }
    ]
}