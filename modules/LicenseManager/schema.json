{
    "version": "1.0.0",
    "module": "license-manager",
    "description": "License keys. Depends on: customers, orders, software-catalog.",
    "tables": [
        {
            "name": "optilarity_licenses",
            "comment": "Software license keys. FKs -> customers, orders, software_products.",
            "columns": [
                {
                    "name": "id",
                    "type": "primary"
                },
                {
                    "name": "license_key",
                    "type": "string",
                    "size": 64,
                    "nullable": false
                },
                {
                    "name": "customer_id",
                    "type": "integer",
                    "nullable": true,
                    "comment": "FK -> optilarity_customers.id"
                },
                {
                    "name": "order_id",
                    "type": "integer",
                    "nullable": true,
                    "comment": "FK -> optilarity_orders.id"
                },
                {
                    "name": "product_id",
                    "type": "integer",
                    "nullable": true,
                    "comment": "FK -> optilarity_software_products.id"
                },
                {
                    "name": "status",
                    "type": "enum",
                    "values": [
                        "active",
                        "expired",
                        "suspended",
                        "revoked"
                    ],
                    "default": "active",
                    "nullable": false
                },
                {
                    "name": "license_type",
                    "type": "enum",
                    "values": [
                        "optilarity",
                        "envato",
                        "templatemonster"
                    ],
                    "default": "optilarity",
                    "nullable": false
                },
                {
                    "name": "license_mode",
                    "type": "enum",
                    "values": [
                        "strict",
                        "share"
                    ],
                    "default": "strict",
                    "nullable": false
                },
                {
                    "name": "thirdparty_code",
                    "type": "string",
                    "size": 128,
                    "nullable": true
                },
                {
                    "name": "software_version",
                    "type": "string",
                    "size": 32,
                    "nullable": true
                },
                {
                    "name": "email",
                    "type": "string",
                    "size": 128,
                    "nullable": true,
                    "comment": "Used for external verification or when customer_id is missing"
                },
                {
                    "name": "max_activations",
                    "type": "integer",
                    "default": 1
                },
                {
                    "name": "activations_used",
                    "type": "integer",
                    "default": 0
                },
                {
                    "name": "activated_domains",
                    "type": "json",
                    "nullable": true,
                    "comment": "JSON array of activated domain names"
                },
                {
                    "name": "expires_at",
                    "type": "date",
                    "nullable": true
                },
                {
                    "name": "last_verified_at",
                    "type": "datetime",
                    "nullable": true
                },
                {
                    "name": "created_at",
                    "type": "datetime",
                    "nullable": false
                },
                {
                    "name": "updated_at",
                    "type": "datetime",
                    "nullable": true
                }
            ],
            "indexes": [
                {
                    "name": "uq_license_key",
                    "columns": [
                        "license_key"
                    ],
                    "unique": true
                },
                {
                    "name": "idx_license_customer",
                    "columns": [
                        "customer_id"
                    ]
                },
                {
                    "name": "idx_license_order",
                    "columns": [
                        "order_id"
                    ]
                },
                {
                    "name": "idx_license_product",
                    "columns": [
                        "product_id"
                    ]
                },
                {
                    "name": "idx_license_status",
                    "columns": [
                        "status"
                    ]
                },
                {
                    "name": "idx_license_expires",
                    "columns": [
                        "expires_at"
                    ]
                }
            ],
            "foreign_keys": [
                {
                    "column": "customer_id",
                    "references": "optilarity_customers",
                    "on": "id",
                    "on_delete": "SET NULL",
                    "on_update": "CASCADE"
                },
                {
                    "column": "order_id",
                    "references": "optilarity_orders",
                    "on": "id",
                    "on_delete": "SET NULL",
                    "on_update": "CASCADE"
                },
                {
                    "column": "product_id",
                    "references": "optilarity_software_products",
                    "on": "id",
                    "on_delete": "SET NULL",
                    "on_update": "CASCADE"
                }
            ]
        },
        {
            "name": "optilarity_user_keys",
            "comment": "Stores RSA private keys per customer.",
            "columns": [
                {
                    "name": "id",
                    "type": "primary"
                },
                {
                    "name": "customer_id",
                    "type": "integer",
                    "nullable": false
                },
                {
                    "name": "private_key",
                    "type": "text",
                    "nullable": false
                },
                {
                    "name": "created_at",
                    "type": "datetime",
                    "nullable": false
                },
                {
                    "name": "updated_at",
                    "type": "datetime",
                    "nullable": true
                }
            ],
            "indexes": [
                {
                    "name": "uq_customer_key",
                    "columns": [
                        "customer_id"
                    ],
                    "unique": true
                }
            ],
            "foreign_keys": [
                {
                    "column": "customer_id",
                    "references": "optilarity_customers",
                    "on": "id",
                    "on_delete": "CASCADE",
                    "on_update": "CASCADE"
                }
            ]
        },
        {
            "name": "optilarity_license_activations",
            "comment": "History of license activation attempts.",
            "columns": [
                {
                    "name": "id",
                    "type": "primary"
                },
                {
                    "name": "license_id",
                    "type": "integer",
                    "nullable": false
                },
                {
                    "name": "domain",
                    "type": "string",
                    "size": 255,
                    "nullable": true
                },
                {
                    "name": "ip_address",
                    "type": "string",
                    "size": 45,
                    "nullable": true
                },
                {
                    "name": "user_agent",
                    "type": "text",
                    "nullable": true
                },
                {
                    "name": "status",
                    "type": "string",
                    "size": 20,
                    "default": "success"
                },
                {
                    "name": "message",
                    "type": "text",
                    "nullable": true
                },
                {
                    "name": "created_at",
                    "type": "datetime",
                    "nullable": false
                }
            ],
            "indexes": [
                {
                    "name": "idx_activation_license",
                    "columns": [
                        "license_id"
                    ]
                },
                {
                    "name": "idx_activation_domain",
                    "columns": [
                        "domain"
                    ]
                }
            ],
            "foreign_keys": [
                {
                    "column": "license_id",
                    "references": "optilarity_licenses",
                    "on": "id",
                    "on_delete": "CASCADE",
                    "on_update": "CASCADE"
                }
            ]
        }
    ]
}