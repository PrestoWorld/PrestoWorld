{
    "version": "1.0.0",
    "module": "reminder-manager",
    "description": "Manages notifications for service expirations and warranty ends.",
    "tables": [
        {
            "name": "optilarity_reminder_logs",
            "comment": "Tracks sent reminders to prevent duplicates.",
            "columns": [
                {
                    "name": "id",
                    "type": "primary"
                },
                {
                    "name": "customer_id",
                    "type": "integer",
                    "nullable": false
                },
                {
                    "name": "subject_type",
                    "type": "string",
                    "size": 50,
                    "comment": "license, domain, hosting, web_service"
                },
                {
                    "name": "subject_id",
                    "type": "integer",
                    "nullable": false
                },
                {
                    "name": "event_type",
                    "type": "string",
                    "size": 50,
                    "comment": "expiration, warranty_end"
                },
                {
                    "name": "channel",
                    "type": "string",
                    "size": 20,
                    "comment": "email, telegram, sms"
                },
                {
                    "name": "sent_at",
                    "type": "datetime",
                    "nullable": false
                }
            ],
            "indexes": [
                {
                    "name": "idx_reminder_subject",
                    "columns": [
                        "subject_type",
                        "subject_id"
                    ]
                },
                {
                    "name": "idx_reminder_customer",
                    "columns": [
                        "customer_id"
                    ]
                }
            ],
            "foreign_keys": [
                {
                    "column": "customer_id",
                    "references": "optilarity_customers",
                    "on": "id",
                    "on_delete": "CASCADE"
                }
            ]
        },
        {
            "name": "optilarity_customer_notification_settings",
            "comment": "User preferences for notification channels.",
            "columns": [
                {
                    "name": "id",
                    "type": "primary"
                },
                {
                    "name": "customer_id",
                    "type": "integer",
                    "nullable": false
                },
                {
                    "name": "channel",
                    "type": "enum",
                    "values": [
                        "email",
                        "telegram",
                        "sms"
                    ],
                    "nullable": false
                },
                {
                    "name": "identifier",
                    "type": "string",
                    "size": 255,
                    "nullable": true,
                    "comment": "Telegram Chat ID, Phone Number, etc."
                },
                {
                    "name": "is_enabled",
                    "type": "boolean",
                    "default": true
                },
                {
                    "name": "created_at",
                    "type": "datetime",
                    "nullable": false
                },
                {
                    "name": "updated_at",
                    "type": "datetime",
                    "nullable": true
                }
            ],
            "indexes": [
                {
                    "name": "uq_customer_channel",
                    "columns": [
                        "customer_id",
                        "channel"
                    ],
                    "unique": true
                }
            ],
            "foreign_keys": [
                {
                    "column": "customer_id",
                    "references": "optilarity_customers",
                    "on": "id",
                    "on_delete": "CASCADE"
                }
            ]
        }
    ]
}