{
    "version": "1.0.0",
    "module": "profile",
    "description": "Extended user profiles. Depends on nothing (uses user_id FK loosely).",
    "tables": [
        {
            "name": "optilarity_profiles",
            "comment": "Extended profile data for users. Soft-linked to user_id (no strict FK — user table varies by auth driver).",
            "columns": [
                {
                    "name": "id",
                    "type": "primary"
                },
                {
                    "name": "user_id",
                    "type": "integer",
                    "nullable": false,
                    "comment": "App user ID (auth driver dependent)"
                },
                {
                    "name": "display_name",
                    "type": "string",
                    "size": 200,
                    "nullable": true
                },
                {
                    "name": "avatar_url",
                    "type": "string",
                    "size": 500,
                    "nullable": true
                },
                {
                    "name": "bio",
                    "type": "text",
                    "nullable": true
                },
                {
                    "name": "website",
                    "type": "string",
                    "size": 500,
                    "nullable": true
                },
                {
                    "name": "timezone",
                    "type": "string",
                    "size": 100,
                    "nullable": true
                },
                {
                    "name": "locale",
                    "type": "string",
                    "size": 20,
                    "nullable": true,
                    "default": "en"
                },
                {
                    "name": "preferences",
                    "type": "json",
                    "nullable": true,
                    "comment": "UI/notification preferences as JSON"
                },
                {
                    "name": "social_links",
                    "type": "json",
                    "nullable": true,
                    "comment": "JSON: {twitter, github, linkedin, ...}"
                },
                {
                    "name": "created_at",
                    "type": "datetime",
                    "nullable": false
                },
                {
                    "name": "updated_at",
                    "type": "datetime",
                    "nullable": true
                }
            ],
            "indexes": [
                {
                    "name": "uq_profile_user",
                    "columns": [
                        "user_id"
                    ],
                    "unique": true
                }
            ]
        }
    ]
}