{
    "version": "1.0.0",
    "module": "invoices",
    "description": "Invoices table. Depends on: customers, orders.",
    "tables": [
        {
            "name": "optilarity_invoices",
            "comment": "Customer invoices. FKs -> customers + orders.",
            "columns": [
                {
                    "name": "id",
                    "type": "primary"
                },
                {
                    "name": "invoice_number",
                    "type": "string",
                    "size": 64,
                    "nullable": false
                },
                {
                    "name": "order_id",
                    "type": "integer",
                    "nullable": true,
                    "comment": "FK -> optilarity_orders.id"
                },
                {
                    "name": "customer_id",
                    "type": "integer",
                    "nullable": true,
                    "comment": "FK -> optilarity_customers.id"
                },
                {
                    "name": "customer_email",
                    "type": "string",
                    "size": 255,
                    "nullable": true
                },
                {
                    "name": "customer_name",
                    "type": "string",
                    "size": 200,
                    "nullable": true
                },
                {
                    "name": "status",
                    "type": "enum",
                    "values": [
                        "draft",
                        "sent",
                        "paid",
                        "overdue",
                        "cancelled"
                    ],
                    "default": "draft",
                    "nullable": false
                },
                {
                    "name": "subtotal",
                    "type": "decimal",
                    "precision": 10,
                    "scale": 2,
                    "default": 0
                },
                {
                    "name": "tax",
                    "type": "decimal",
                    "precision": 10,
                    "scale": 2,
                    "default": 0
                },
                {
                    "name": "total",
                    "type": "decimal",
                    "precision": 10,
                    "scale": 2,
                    "default": 0
                },
                {
                    "name": "currency",
                    "type": "string",
                    "size": 10,
                    "default": "USD"
                },
                {
                    "name": "line_items",
                    "type": "json",
                    "nullable": true,
                    "comment": "JSON array of line items"
                },
                {
                    "name": "due_date",
                    "type": "date",
                    "nullable": true
                },
                {
                    "name": "notes",
                    "type": "text",
                    "nullable": true
                },
                {
                    "name": "created_at",
                    "type": "datetime",
                    "nullable": false
                },
                {
                    "name": "paid_at",
                    "type": "datetime",
                    "nullable": true
                },
                {
                    "name": "updated_at",
                    "type": "datetime",
                    "nullable": true
                }
            ],
            "indexes": [
                {
                    "name": "uq_invoice_number",
                    "columns": [
                        "invoice_number"
                    ],
                    "unique": true
                },
                {
                    "name": "idx_invoice_order",
                    "columns": [
                        "order_id"
                    ]
                },
                {
                    "name": "idx_invoice_customer",
                    "columns": [
                        "customer_id"
                    ]
                },
                {
                    "name": "idx_invoice_status",
                    "columns": [
                        "status"
                    ]
                },
                {
                    "name": "idx_invoice_due",
                    "columns": [
                        "due_date"
                    ]
                }
            ],
            "foreign_keys": [
                {
                    "column": "customer_id",
                    "references": "optilarity_customers",
                    "on": "id",
                    "on_delete": "SET NULL",
                    "on_update": "CASCADE"
                },
                {
                    "column": "order_id",
                    "references": "optilarity_orders",
                    "on": "id",
                    "on_delete": "SET NULL",
                    "on_update": "CASCADE"
                }
            ]
        }
    ]
}