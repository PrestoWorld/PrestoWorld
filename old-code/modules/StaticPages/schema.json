{
    "version": "1.0.0",
    "module": "static-pages",
    "description": "Static Pages Management (About, Contact, Privacy)",
    "tables": [
        {
            "name": "presto_static_pages",
            "columns": [
                {
                    "name": "id",
                    "type": "primary",
                    "increment": true
                },
                {
                    "name": "title",
                    "type": "string",
                    "size": 255
                },
                {
                    "name": "slug",
                    "type": "string",
                    "size": 255
                },
                {
                    "name": "content",
                    "type": "longText"
                },
                {
                    "name": "status",
                    "type": "enum",
                    "values": [
                        "draft",
                        "publish"
                    ],
                    "default": "publish"
                },
                {
                    "name": "created_at",
                    "type": "datetime"
                },
                {
                    "name": "updated_at",
                    "type": "datetime",
                    "nullable": true
                }
            ],
            "indexes": [
                {
                    "name": "idx_page_slug",
                    "columns": [
                        "slug"
                    ],
                    "unique": true
                }
            ]
        },
        {
            "name": "presto_translations_static_pages",
            "columns": [
                {
                    "name": "id",
                    "type": "primary",
                    "increment": true
                },
                {
                    "name": "static_page_id",
                    "type": "integer"
                },
                {
                    "name": "language",
                    "type": "string",
                    "size": 10
                },
                {
                    "name": "title",
                    "type": "string",
                    "size": 255,
                    "nullable": true
                },
                {
                    "name": "content",
                    "type": "longText",
                    "nullable": true
                },
                {
                    "name": "seo_title",
                    "type": "string",
                    "size": 255,
                    "nullable": true
                },
                {
                    "name": "seo_description",
                    "type": "string",
                    "size": 500,
                    "nullable": true
                }
            ],
            "indexes": [
                {
                    "name": "idx_page_trans_lookup",
                    "columns": [
                        "static_page_id",
                        "language"
                    ],
                    "unique": true
                }
            ],
            "foreign_keys": [
                {
                    "name": "fk_page_trans_obj",
                    "column": "static_page_id",
                    "references": "presto_static_pages",
                    "on": "id",
                    "on_delete": "CASCADE"
                }
            ]
        }
    ]
}