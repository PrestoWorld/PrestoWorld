{
    "version": "1.0.0",
    "module": "blog",
    "description": "Native Blog Module with Tags, Comments and Modern UI",
    "tables": [
        {
            "name": "presto_blog_categories",
            "columns": [
                {
                    "name": "id",
                    "type": "primary"
                },
                {
                    "name": "name",
                    "type": "string",
                    "size": 100
                },
                {
                    "name": "slug",
                    "type": "string",
                    "size": 100
                },
                {
                    "name": "description",
                    "type": "text",
                    "nullable": true
                },
                {
                    "name": "created_at",
                    "type": "datetime"
                }
            ],
            "indexes": [
                {
                    "columns": [
                        "slug"
                    ],
                    "unique": true
                }
            ]
        },
        {
            "name": "presto_blog_tags",
            "columns": [
                {
                    "name": "id",
                    "type": "primary"
                },
                {
                    "name": "name",
                    "type": "string",
                    "size": 100
                },
                {
                    "name": "slug",
                    "type": "string",
                    "size": 100
                }
            ],
            "indexes": [
                {
                    "columns": [
                        "slug"
                    ],
                    "unique": true
                }
            ]
        },
        {
            "name": "presto_blog_posts",
            "columns": [
                {
                    "name": "id",
                    "type": "primary"
                },
                {
                    "name": "category_id",
                    "type": "integer"
                },
                {
                    "name": "author_id",
                    "type": "integer",
                    "nullable": true
                },
                {
                    "name": "title",
                    "type": "string",
                    "size": 255
                },
                {
                    "name": "slug",
                    "type": "string",
                    "size": 255
                },
                {
                    "name": "excerpt",
                    "type": "text",
                    "nullable": true
                },
                {
                    "name": "content",
                    "type": "longText"
                },
                {
                    "name": "featured_image",
                    "type": "string",
                    "size": 255,
                    "nullable": true
                },
                {
                    "name": "status",
                    "type": "enum",
                    "values": [
                        "draft",
                        "publish"
                    ],
                    "default": "publish"
                },
                {
                    "name": "is_featured",
                    "type": "boolean",
                    "default": false
                },
                {
                    "name": "reading_time",
                    "type": "integer",
                    "default": 5
                },
                {
                    "name": "view_count",
                    "type": "integer",
                    "default": 0
                },
                {
                    "name": "published_at",
                    "type": "datetime"
                },
                {
                    "name": "created_at",
                    "type": "datetime"
                },
                {
                    "name": "updated_at",
                    "type": "datetime",
                    "nullable": true
                }
            ],
            "indexes": [
                {
                    "columns": [
                        "slug"
                    ],
                    "unique": true
                },
                {
                    "columns": [
                        "category_id"
                    ]
                }
            ],
            "foreign_keys": [
                {
                    "column": "category_id",
                    "references": "presto_blog_categories",
                    "on": "id",
                    "on_delete": "CASCADE"
                }
            ]
        },
        {
            "name": "presto_blog_post_tags",
            "columns": [
                {
                    "name": "post_id",
                    "type": "integer"
                },
                {
                    "name": "tag_id",
                    "type": "integer"
                }
            ],
            "indexes": [
                {
                    "columns": [
                        "post_id",
                        "tag_id"
                    ],
                    "unique": true
                }
            ],
            "foreign_keys": [
                {
                    "column": "post_id",
                    "references": "presto_blog_posts",
                    "on": "id",
                    "on_delete": "CASCADE"
                },
                {
                    "column": "tag_id",
                    "references": "presto_blog_tags",
                    "on": "id",
                    "on_delete": "CASCADE"
                }
            ]
        },
        {
            "name": "presto_blog_comments",
            "columns": [
                {
                    "name": "id",
                    "type": "primary"
                },
                {
                    "name": "post_id",
                    "type": "integer"
                },
                {
                    "name": "parent_id",
                    "type": "integer",
                    "nullable": true
                },
                {
                    "name": "author_name",
                    "type": "string",
                    "size": 100
                },
                {
                    "name": "author_email",
                    "type": "string",
                    "size": 255
                },
                {
                    "name": "content",
                    "type": "text"
                },
                {
                    "name": "status",
                    "type": "enum",
                    "values": [
                        "pending",
                        "approved",
                        "spam"
                    ],
                    "default": "approved"
                },
                {
                    "name": "created_at",
                    "type": "datetime"
                }
            ],
            "foreign_keys": [
                {
                    "column": "post_id",
                    "references": "presto_blog_posts",
                    "on": "id",
                    "on_delete": "CASCADE"
                }
            ]
        }
    ]
}