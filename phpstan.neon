includes:
    - phpstan-baseline.neon

parameters:
    level: 9
    paths:
        - app
        - framework/presto
        - framework/witals/src
    excludePaths:
        - framework/presto/Modules/Gutenberg/Pattern/wp-stubs.php
    tmpDir: storage/framework/cache/phpstan
    reportUnmatchedIgnoredErrors: false
    treatPhpDocTypesAsCertain: false
    checkUninitializedProperties: true
    checkExplicitMixedMissingReturn: true
    checkTooWideReturnTypesInProtectedAndPublicMethods: true
    checkAdvancedIsset: true

    ignoreErrors:
        # Allow dynamic property access on legacy WordPress objects
        - '#Access to an undefined property#'
        # Allow mixed return from WordPress compatibility functions
        - '#Method .*::resolveUserRole\(\) should return string but returns mixed#'
        - '#Method .*::extractMeta\(\) should return mixed but returns mixed#'
        # Interface/contract files use abstract array types by design
        - message: '#Missing iterable value type#'
          paths:
              - framework/witals/src/Contracts/
              - framework/witals/src/Context/Contracts/
              - app/Console/Commands/
        # External SDKs: Cycle ORM, AWS S3, GCS, BunnyCDN
        - '#Call to an undefined method object::(query|putObject|deleteObject|doesObjectExist|listObjectsV2|getContents|upload)#'
        - '#Call to an undefined method Witals\\Framework\\Contracts\\Container::call\(\)#'
        - '#Call to an undefined method Witals\\Framework\\Application::config\(\)#'
        # glob()/scandir() can return false — standard PHP pattern
        - '#(sort|count|rsort) expects list.*\|false given$#'
        # DebugBar class resolved via container with has() guard
        - '#Class App\\Foundation\\Debug\\DebugBar not found#'
        - '#Cannot call method render\(\) on mixed#'
