            echo "✅ {$result}\n";
        }

        echo "\n✨ Seeding complete!\n";
    } catch (\Throwable $e) {
        echo "❌ Error during seeding: {$e->getMessage()}\n";
        exit(1);
    }
}

function exitWithUnknownCommand(string $command): never
{
    echo "Unknown command: {$command}\n";
    displayHelp();
    exit(1);
}
