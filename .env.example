APP_NAME="PrestoWorld DigitalCore"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://prestoworld.localhost

DB_CONNECTION=pgsql
DB_PGSQL_DATABASE=prestoworld
DB_PGSQL_HOST=127.0.0.1
DB_PGSQL_PORT=5432
DB_PGSQL_USERNAME=prestoworld
DB_PGSQL_PASSWORD=prestoworld

DB_MYSQL_DATABASE=
DB_MYSQL_HOST=127.0.0.1
DB_MYSQL_PORT=3306
DB_MYSQL_USERNAME=root
DB_MYSQL_PASSWORD=root

CACHE_DRIVER=file
QUEUE_CONNECTION=sync

# Marketplace API
MARKETPLACE_API_URL=https://prestoworld-marketplace.pages.dev
MARKETPLACE_API_KEY=

# Active theme. WP_THEME_ACTIVE is what the WordPress bridge honors; keep it in
# sync with PW_ACTIVE_THEME so the configured theme wins over auto-detection.
PW_ACTIVE_THEME=jankx
PW_THEME_ACTIVE=jankx
