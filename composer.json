{
    "name": "prestoworld/prestoworld",
    "description": "Premium Enterprise Management & Licensing Framework",
    "type": "project",
    "license": "proprietary",
    "authors": [
        {
            "name": "Puleeno Nguyen",
            "email": "puleeno@gmail.com"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.1",
        "witals/framework": "*",
        "prestoworld/marketplace-sdk": "*",
        "prestoworld/wp-bridge": "*",
        "prestoworld/search-engine": "dev-master",
        "prestoworld/gutenberg-core": "dev-master",
        "prestoworld/wordpress-shim": "dev-master"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "PrestoWorld\\": "framework/presto/",
            "PrestoWorld\\Core\\": "app/src/Core/",
            "PrestoWorld\\Modules\\": "modules/",
            "PrestoWorld\\Modules\\ModuleManager\\": "framework/presto/Modules/ModuleManager/",
            "Presto\\": "framework/presto/",
            "PrestoWorld\\Modules\\Schema\\": "framework/presto/Modules/Schema/"
        },
        "classmap": [
            "framework/presto/Context/Builder/"
        ]
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10",
        "phpstan/phpstan": "^2.2"
    }
}
