{
    "name": "prestoworld/prestoworld",
    "description": "Premium Enterprise Management & Licensing Framework",
    "type": "project",
    "license": "proprietary",
    "authors": [
        {
            "name": "Puleeno Nguyen",
            "email": "puleeno@gmail.com"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.1",
        "witals/framework": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "PrestoWorld\\": "framework/presto/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "framework/witals",
            "options": {
                "symlink": true
            }
        }
    ],
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}